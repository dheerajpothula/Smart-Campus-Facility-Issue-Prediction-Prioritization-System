# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/

# Streamlit run cache
.streamlit/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Data files (keep directory structure via .gitkeep)
**/data/raw/*
!**/data/raw/.gitkeep
**/data/processed/*
!**/data/processed/.gitkeep
**/data/synthetic/*
!**/data/synthetic/.gitkeep

# Trained Model Artifacts
**/models/*
!**/models/.gitkeep
*.joblib
*.pkl

# Logs
*.log

# OS & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
