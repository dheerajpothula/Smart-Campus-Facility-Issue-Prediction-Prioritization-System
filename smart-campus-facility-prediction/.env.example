# ==============================================================================
# FIPP — Campus Deployment Production Environment Variables (.env.example)
# Copy this file to .env and configure for the target university server.
# NEVER commit the actual .env file or sensitive credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Runtime Mode
# ------------------------------------------------------------------------------
# Set to 'production' for campus deployment; 'development' for staging/testing.
FIPP_ENV=production

# ------------------------------------------------------------------------------
# 2. Authentication & Cryptography
# ------------------------------------------------------------------------------
# High-entropy cryptographic salt for PBKDF2-HMAC-SHA256 password hashing.
# In production, generate a secure random 32+ character string (e.g. python -c "import secrets; print(secrets.token_hex(32))").
FIPP_AUTH_SALT=generate_unique_secret_salt_here

# Number of PBKDF2 iterations for key derivation (OWASP recommended >= 600,000 for PBKDF2-HMAC-SHA256).
FIPP_HASH_ITERATIONS=600000

# Optional: Override administrator password hashes via environment variables.
# Format: hex-encoded PBKDF2-HMAC-SHA256 string generated using FIPP_AUTH_SALT.
# FIPP_ADMIN_HASH_ADM_2026_001=e70edb936a5ebea8ae511e3f3c31ba85e568ae1e0d15d6d561f460f05d1acf5a
# FIPP_ADMIN_HASH_ADM_2026_002=14ed4b75d80509c8f2b55d8ed7c44be15638c5d9bf185bb22f7cc2ac54f2fa39
# FIPP_ADMIN_HASH_ADM_2026_003=a25ad46752736c276c34fed62c7c7b9350aa67b9c763f3ba91d67aee012abfd7

# ------------------------------------------------------------------------------
# 3. Persistent Data Storage & Directories
# ------------------------------------------------------------------------------
# Full absolute path to persistent complaints JSON datastore.
# Default if unset: <PROJECT_ROOT>/data/processed/complaints.json
# FIPP_DATA_FILE=/var/lib/fipp/data/complaints.json

# Directory where database backup archives are generated by backup_database.py.
# Default if unset: <PROJECT_ROOT>/data/backups
# FIPP_BACKUP_DIR=/var/backups/fipp

# Backup retention policy (number of days before automated backup pruning).
FIPP_BACKUP_RETENTION_DAYS=30

# Optional directory for student issue photo uploads.
# FIPP_UPLOAD_DIR=/var/lib/fipp/uploads

# ------------------------------------------------------------------------------
# 4. Streamlit Server Configuration
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=10
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
