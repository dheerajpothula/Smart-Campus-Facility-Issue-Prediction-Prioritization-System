# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Streamlit run cache
.streamlit/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Data files (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep

# Trained Model Artifacts (keep directory structure via .gitkeep)
models/*
!models/.gitkeep
*.joblib
*.pkl

# Logs & temp files
*.log
tmp/
temp/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
